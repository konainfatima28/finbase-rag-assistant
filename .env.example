# FinBase assistant — environment variables. Copy to `.env` (git-ignored) and fill in OPENAI_API_KEY.
# Every key overrides the default in config/settings.yaml. Secrets live ONLY in .env / the host's env.
# OpenAI is used for BOTH local development and production (DECISIONS D-011). No local model server is needed.
# Only OPENAI_API_KEY is required; every other value below is the current default.

# ---- Provider --------------------------------------------------------------------------------
LLM_PROVIDER=openai
# Embedding provider (empty = LLM_PROVIDER). Must match the index on disk; checked at startup.
EMBED_PROVIDER=openai
# REQUIRED. Create at https://platform.openai.com/api-keys . Never commit a real key.
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway / Azure endpoint
OPENAI_BASE_URL=
# Chat model for answers (non-reasoning model so temperature=0 is honoured)
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Embedding model. Changing it requires re-running `python -m app.ingest` (separate index dir per model).
OPENAI_EMBED_MODEL=text-embedding-3-small
# Query rewrite / translation / sub-query model (empty = OPENAI_CHAT_MODEL)
OPENAI_REWRITE_MODEL=
# LLM-as-judge for evaluation (empty = LLM_PROVIDER / OPENAI_CHAT_MODEL)
JUDGE_PROVIDER=
JUDGE_MODEL=

# ---- Generation ------------------------------------------------------------------------------
TEMPERATURE=0
SEED=42
MAX_TOKENS=500
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
REWRITE_TIMEOUT_S=15
# Prompt version (part of the answer-cache key)
PROMPT_VERSION=v2

# ---- Retrieval (PROMPT.md §6) --------------------------------------------------------------------
DENSE_K=20
BM25_K=20
RRF_K=60
RERANK_TOP_N=12
FINAL_K=5
CONTEXT_TOKEN_BUDGET=2500
BOILERPLATE_WEIGHT=0.6
MAX_PER_SECTION=2
ROUTER_BOOST=1.15
FAQ_WEIGHT=0.95
# flashrank | none   (none = no rerank cost; see README "Cost & latency")
RERANKER=flashrank
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# Passages per reranker forward pass (memory grows with batch x length^2; D-034)
RERANK_BATCH_SIZE=4
# Broad questions -> up to MAX_SUBQUERIES sub-queries, merged before context assembly (D-030)
MAX_SUBQUERIES=3
SUBQUERY_RERANK_TOP_N=8
MULTI_QUERY_FINAL_K=8
MULTI_QUERY_TOKEN_BUDGET=3800

# ---- Chunking / ingestion ------------------------------------------------------------------------
CHUNK_MAX_TOKENS=600
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.12
EMBED_BATCH_SIZE=64

# ---- API ---------------------------------------------------------------------------------------
# Comma-separated exact origins (add your Vercel URL). '*' is ignored.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT=20/minute
MAX_MESSAGE_CHARS=2000
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=6000
SSE_HEARTBEAT_S=15
CACHE_TTL_S=3600
CACHE_MAX_ITEMS=512
SESSION_TTL_S=3600
LOG_LEVEL=INFO
PORT=8000

# ---- Linux memory (glibc only; ignored on Windows/macOS). Set on Render via render.yaml (D-035) ---------
# Fixed thresholds: large transient ONNX/FlashRank allocations (reranker attention tensors, ~30 MB each)
# are mmap'ed and returned to the OS when freed, instead of being kept in the heap (RSS retention).
MALLOC_MMAP_THRESHOLD_=131072
MALLOC_TRIM_THRESHOLD_=131072

# ---- Support contacts shown when an answer is not in the knowledge base (must exist in the KB) ---
SUPPORT_EMAIL=support@finbase.com
SUPPORT_HELPLINE=1800-FIN-BASE (1800-346-2273)

# ---- Paths (relative to the repo root; defaults shown, normally left unset) ----------------------
# DATA_DIR=data
# INDEX_ROOT=indexes
# CACHE_DIR=.cache
# PROMPTS_DIR=prompts
# EVAL_RESULTS_DIR=eval/results
# FEEDBACK_LOG_PATH=logs/feedback.jsonl
# THRESHOLDS_PATH=config/thresholds.json
# PRICING_PATH=config/pricing.yaml

# ---- Frontend (web/, set in Vercel or web/.env.local; public, not a secret) ----------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
